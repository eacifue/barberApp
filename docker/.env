# Runtime
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5001

# PostgreSQL
POSTGRES_DB=barberia_db
POSTGRES_USER=barberia_user
POSTGRES_PASSWORD=Barberia123!
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_BLOCK_TTL_MINUTES=5

# JWT
JWT_KEY=barberia-super-secret-key-minimum-32-chars!!
JWT_ISSUER=barberia-api
JWT_AUDIENCE=barberia-flutter-app
JWT_EXPIRATION_MINUTES=1440

# Firebase (leave empty if not using FCM locally)
FIREBASE_PROJECT_ID=REEMPLAZAR
FIREBASE_CREDENTIAL_PATH=/app/firebase-credentials.json

# CORS
CORS_ALLOWED_ORIGIN_0=http://localhost:3000
